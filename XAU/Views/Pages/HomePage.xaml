<Page
    x:Class="XAU.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XAU.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HomePage"
    d:DataContext="{d:DesignInstance local:HomePage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="White"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#E6141018" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="#4D8B5CF6" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Caption" TargetType="ui:TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Value" TargetType="ui:TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,12">

            <!-- Status bar -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBlock
                            Margin="0,0,24,0"
                            Text="{Binding ViewModel.Attached}"
                            Foreground="{Binding ViewModel.AttachedColor}" />
                        <ui:TextBlock
                            Text="{Binding ViewModel.LoggedIn}"
                            Foreground="{Binding ViewModel.LoggedInColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Padding="17,5"
                            Content="{Binding ViewModel.LoginText, Mode=OneWay}"
                            Command="{Binding ViewModel.OAuthLoginCommand, Mode=OneWay}" />
                        <ui:Button
                            Padding="17,5"
                            Content="Refresh"
                            IsEnabled="{Binding ViewModel.IsLoggedIn, Mode=OneWay}"
                            Command="{Binding ViewModel.RefreshProfileCommand, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Profile -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Image
                        Width="96"
                        Height="96"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top"
                        CornerRadius="48"
                        Source="{Binding ViewModel.GamerPic, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding ViewModel.GamerTag, Mode=OneWay}" />
                        <ui:TextBlock
                            Margin="0,2,0,10"
                            FontSize="12"
                            Foreground="#CCFFFFFF"
                            Text="{Binding ViewModel.Xuid, Mode=OneWay}" />
                        <WrapPanel>
                            <Border Style="{StaticResource Pill}">
                                <ui:TextBlock FontSize="13" Foreground="White" Text="{Binding ViewModel.GamerScore, Mode=OneWay}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <ui:TextBlock FontSize="13" Foreground="White" Text="{Binding ViewModel.AccountTier, Mode=OneWay}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <ui:TextBlock FontSize="13" Foreground="White" Text="{Binding ViewModel.Gamepass, Mode=OneWay}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Activity -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <ui:TextBlock Style="{StaticResource Value}" Text="{Binding ViewModel.CurrentlyPlaying, Mode=OneWay}" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <ui:TextBlock Style="{StaticResource Value}" Text="{Binding ViewModel.ActiveDevice, Mode=OneWay}" />
                </Border>
            </Grid>

            <!-- Details -->
            <Border Style="{StaticResource Card}">
                <UniformGrid Columns="3">
                    <ui:TextBlock Margin="0,0,0,10" Style="{StaticResource Value}" Text="{Binding ViewModel.ProfileRep, Mode=OneWay}" />
                    <ui:TextBlock Margin="0,0,0,10" Style="{StaticResource Value}" Text="{Binding ViewModel.IsVerified, Mode=OneWay}" />
                    <ui:TextBlock Margin="0,0,0,10" Style="{StaticResource Value}" Text="{Binding ViewModel.Tenure, Mode=OneWay}" />
                    <ui:TextBlock Style="{StaticResource Value}" Text="{Binding ViewModel.Location, Mode=OneWay}" />
                    <ui:TextBlock Style="{StaticResource Value}" Text="{Binding ViewModel.Followers, Mode=OneWay}" />
                    <ui:TextBlock Style="{StaticResource Value}" Text="{Binding ViewModel.Following, Mode=OneWay}" />
                </UniformGrid>
            </Border>

            <!-- Bio -->
            <Border Style="{StaticResource Card}">
                <ui:TextBlock Style="{StaticResource Value}" Text="{Binding ViewModel.Bio, Mode=OneWay}" />
            </Border>

            <!-- Badges -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="Badges" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Watermarks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image
                                    Width="64"
                                    Height="64"
                                    Margin="0,0,8,8"
                                    Source="{Binding ImageUrl}"
                                    Stretch="Uniform" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
