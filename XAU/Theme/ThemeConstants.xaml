<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Thickness x:Key="PageMargin">15</Thickness>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FFE8E8E8" />

    <RadialGradientBrush x:Key="ApplicationBackgroundBrush"
                         Center="0.42,0.38"
                         GradientOrigin="0.22,0.16"
                         RadiusX="0.95"
                         RadiusY="0.9">
        <GradientStop Color="#FF542596" Offset="0.0" />
        <GradientStop Color="#FF321360" Offset="0.24" />
        <GradientStop Color="#FF130B21" Offset="0.58" />
        <GradientStop Color="#FF050508" Offset="1.0" />
    </RadialGradientBrush>
</ResourceDictionary>

