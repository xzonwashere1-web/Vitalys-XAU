<Page x:Class="XAU.Views.Pages.InfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:XAU.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="InfoPage"
      d:DataContext="{d:DesignInstance local:InfoPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="Vitalys XAU" />
            <TextBlock Margin="0,6,0,24" FontSize="15" Opacity="0.72"
                       Text="Xbox Achievement Unlocker · Community fork by Vitaly" />

            <Border Padding="22" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="About this build" />
                    <TextBlock Margin="0,10,0,0" FontSize="15" Text="{Binding ViewModel.ToolVersion}" />
                    <TextBlock Margin="0,8,0,0" FontSize="15" Text="Maintainer: Vitaly" />
                    <TextBlock Margin="0,8,0,0" FontSize="15" Text="Original project created by Draff with contributions from the Xbox Achievement Unlocker community." TextWrapping="Wrap" />
                    <TextBlock Margin="0,14,0,0" FontSize="15" TextWrapping="Wrap"
                               Text="Free and open source. This community fork is not affiliated with Microsoft or Xbox." />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,26,0,12" FontSize="20" FontWeight="SemiBold" Text="Project links" />
            <WrapPanel>
                <Button Margin="0,0,10,10" Padding="16,9" Content="Original source on GitHub"
                        Command="{Binding ViewModel.OpenGithubUserUrlCommand}" />
                <Button Margin="0,0,10,10" Padding="16,9" Content="Vitalys XAU Discord"
                        Command="{Binding ViewModel.OpenDiscordUrlCommand}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>


