<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Vitalys XAU</AssemblyName>
    <Product>Vitalys XAU</Product>
    <Authors>Vitaly</Authors>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>vitalys-xau.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>26.10.29.1</Version>
    <AssemblyVersion>26.10.29.1</AssemblyVersion>
    <FileVersion>26.10.29.1</FileVersion>
    <Copyright>Vitaly fork; original Xbox Achievement Unlocker by Draff and contributors</Copyright>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="vitalys-xau.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0-preview.3.24172.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Management" Version="9.0.0-preview.3.24172.9" />
    <PackageReference Include="WPF-UI" Version="3.0.0-preview.4" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\vitalys-xau.png" />
    <None Remove="Assets\G.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\vitalys-xau.png" />
    <Resource Include="Assets\G.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Util\XboxAuthNet\Platforms\" />
  </ItemGroup>

</Project>

